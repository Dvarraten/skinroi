{
  "manifest_version": 3,
  "name": "SkinROI Sync",
  "short_name": "SkinROI",
  "version": "0.3.3",
  "description": "CS2 trade sync for SkinROI. Auto-populates float, paint seed, and stickers so trades land in Handle Items with full context.",
  "author": "SkinROI",

  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },

  "permissions": ["storage", "alarms", "cookies"],
  "host_permissions": [
    "*://steamcommunity.com/*",
    "*://*.steampowered.com/*",
    "https://api.csfloat.com/*",
    "https://www.skinroi.com/*",
    "https://skinroi.com/*",
    "https://dvich-cs2-tracker.vercel.app/*",
    "https://*.vercel.app/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*"
  ],

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "SkinROI Sync",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  }
}
