# Copy to .env (PowerShell: Copy-Item env.example .env) and fill in.

# The extension's Bearer secret (see README, "Koppla till ditt konto").
# Leave empty if you use `npm run pair -- ABCD-EFGH` instead.
SKINROI_SECRET=

# SkinROI address. Use www: the apex domain redirects and drops the Bearer header.
SKINROI_URL=https://www.skinroi.com

# Minutes between rounds (the extension uses 5).
POLL_MINUTES=5

# true = no window. If CSFloat/Cloudflare blocks the headless browser,
# set false (a window stays open, minimise it).
HEADLESS=true

# Empty = Playwright's own Chromium. "msedge" = Microsoft Edge (already on
# Windows; use it if Chromium fails with "spawn UNKNOWN"). "chrome" = your installed Google Chrome
# (looks less like a bot, but then SKIP_WHEN_CHROME_OPEN can't tell the two apart).
BROWSER_CHANNEL=

# Windows only: skip a round while your normal Chrome is open, because the
# extension already does the same work then (avoids double CSFloat calls and
# double Redis writes). 0 = always run.
SKIP_WHEN_CHROME_OPEN=1

# Turn parts off: 0 = skip.
RUN_SNIPES=1
RUN_SELL_PRICES=1
